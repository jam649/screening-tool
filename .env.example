# Generate: python3 -c 'import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
SCREENING_TOOL_SECRET_KEY=
SCREENING_TOOL_PORT=8000
TZ=UTC

# Optional public TLS deployment. Set exact hostnames/origins; retain the key above.
# SCREENING_TOOL_ALLOWED_HOSTS=["screening.example.com"]
# SCREENING_TOOL_ALLOWED_ORIGINS=["https://screening.example.com"]
# Explicit connecting proxy IPs/CIDRs only; never wildcard trust.
# SCREENING_TOOL_FORWARDED_ALLOW_IPS=127.0.0.1,::1
